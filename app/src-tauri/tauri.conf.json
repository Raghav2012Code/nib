{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nib",
  "version": "0.2.1",
  "identifier": "dev.nib.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "nib",
        "width": 1000,
        "height": 660,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "theme": null,
        "backgroundColor": "#fbfbfa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
